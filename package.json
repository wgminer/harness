{
  "name": "harness",
  "version": "0.9.0",
  "private": false,
  "license": "MIT",
  "author": "Will Miner",
  "description": "Personal all-in-one desktop app for LLMs (chat, memory, tasks, tools)",
  "repository": {
    "type": "git",
    "url": "https://github.com/wgminer/harness.git"
  },
  "scripts": {
    "dev": "HARNESS_DEV=1 tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:stub-images": "HARNESS_DEV=1 HARNESS_STUB_IMAGES=1 tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:web": "vite",
    "site": "serve site -l 8080",
    "prebuild": "npm run icon:icns && npm run build:speech-helper",
    "build": "vite build",
    "build:web": "vite build",
    "dist": "node scripts/dist-runner.js",
    "dist:quick": "node scripts/dist-runner.js --mac --quick",
    "dist:mac": "node scripts/dist-runner.js --mac",
    "dist:mac:quick": "node scripts/dist-runner.js --mac --quick",
    "dist:mac:replace": "node scripts/dist-runner.js --mac --replace",
    "verify:mac-trust": "node scripts/verify-mac-trust.js",
    "capture:hero": "bash scripts/capture-hero.sh",
    "icons": "node scripts/generate-app-icons.js",
    "icons:trace": "python3 scripts/trace-horse-head-mark.py",
    "icon:icns": "npm run icons",
    "build:speech-helper": "bash scripts/build-speech-helper.sh",
    "release": "node scripts/release.js",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "typecheck": "tsc -p tsconfig.renderer.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "vitest run --config vitest.budget.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@tauri-apps/api": "^2.4.0",
    "lucide-react": "^0.575.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/react-vite": "^10.5.7",
    "@tauri-apps/cli": "^2.4.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.7",
    "globals": "^16.5.0",
    "serve": "^14.2.6",
    "storybook": "^10.5.7",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.0",
    "vitest": "^3.0.5"
  }
}
