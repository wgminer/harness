{
  "version": 1,
  "remoteDir": "inbox/",
  "envelopeSuffix": ".json",
  "kinds": ["dictation", "text", "photo", "file", "link"],
  "attachmentRoles": ["audio", "image", "file"],
  "envelopeFields": [
    "version",
    "id",
    "kind",
    "createdAt",
    "source",
    "text",
    "url",
    "title",
    "attachments"
  ],
  "attachmentFields": ["name", "role", "mimeType", "bytes"],
  "maxTextChars": 200000,
  "maxAttachmentBytes": 104857600,
  "maxAttachments": 8
}
